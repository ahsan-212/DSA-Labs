#include <iostream>
using namespace std;

template <typename T>
class AbstractClass {

public:
    virtual void push(T value) = 0;
    virtual T pop() = 0;
    virtual T top() const = 0;
    virtual bool isEmpty() const = 0;
    virtual bool isFull() const = 0;
    virtual ~AbstractClass() {}

};

template <typename T>
class myStack : public AbstractClass<T> {
    T* arr;
    T* minArr;
    int size;
    int topIndex;

public:

    myStack(T value) {

        size = value;
        arr = new T[size];
        minArr = new T[size];
        topIndex = -1;
    }

    ~myStack() {
        delete[] arr;
        delete[] minArr;
    }

    void push(T value) override {

        if (isFull())
        {
            cout << "Stack is full, cant add more elements." << endl;
        }

            arr[++topIndex] = value;
            
            if (topIndex == 0 || value <= minArr[topIndex - 1]) 
            {
                minArr[topIndex] = value;
            }
            else 
            {
                minArr[topIndex] = minArr[topIndex - 1];
            }
        
    }

    T pop() override {
        if (isEmpty()) 
        {
            cout << "Stack is empty." << endl;
            return T();
        }
        else
        {
            return arr[topIndex--];
        }
    }

    T top()     const override {

        if (isEmpty()) 
        {
            cout << "Stack is empty." << endl;
            return T();
        }
        else
        {
            return arr[topIndex];
        }
    }

    bool isEmpty() const override { return topIndex == -1; }
    bool isFull() const override { return topIndex == size - 1; }

    T getMin() const {
        if (isEmpty()) {
            cout << "Stack is empty, no minimum.\n";
            return T();
        }
        return minArr[topIndex];
    }

    void display() const { 

        for (int i = topIndex; i >= 0; i--)
        {
            cout << arr[i] << " ";
        }
        cout << endl;
    }

};

int main() {

    int value, size, choice;
    cout << "Enter Stack's Size: ";
    cin >> size;

    myStack<int> s (size);
    do {
        cout << "\n1. Push\n2. Pop\n3. Top\n4. Display\n5. Min Value\n 6.exit\nChoice: ";
        cin >> choice;
        if (choice == 1) 
        {
            cout << "Value: ";
            cin >> value;
            s.push(value);
           
        }
        else if(choice == 2)
        {
            cout << "Popped: " << s.pop() << endl;
           
        }
        else if (choice == 3)
        {
            cout << "Top: " << s.top() << endl;
        
        }
        else if (choice == 4) {
            s.display();
           
        }
        else if (choice == 5) {
            cout << "Current Minimum: " << s.getMin() << endl;
        }
     

    } while (choice != 6);

    return 0;

    }




