#include <iostream>
#include <string>
using namespace std;

class Patient {
    string name;
    Patient* next;
    Patient(string n) : name(n), next(nullptr) {}
};

class HospitalQueue {
    Patient* head;
public:
    HospitalQueue() : head(nullptr) {}

    void addPatient(string name) {
        Patient* newPatient = new Patient(name);
        if (!head) { head = newPatient; return; }
        Patient* temp = head;
        while (temp->next) temp = temp->next;
        temp->next = newPatient;
    }

    void removePatient(string name) {
        if (!head) return;
        if (head->name == name) {
            Patient* temp = head;
            head = head->next;
            delete temp;
            return;
        }
        Patient* curr = head;
        while (curr->next && curr->next->name != name) curr = curr->next;
        if (curr->next) {
            Patient* temp = curr->next;
            curr->next = curr->next->next;
            delete temp;
        }
    }

    void display() {
        Patient* temp = head;
        while (temp) {
            cout << temp->name << " -> ";
            temp = temp->next;
        }
        cout << "End" << endl;
    }
};

int main() {
    HospitalQueue q;
    q.addPatient("Alice");
    q.addPatient("Bob");
    q.display();
    q.removePatient("Alice");
    q.display();
    return 0;
}
