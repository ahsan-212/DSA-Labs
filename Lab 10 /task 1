#include <iostream>
using namespace std;

int sumArray(int arr[], int size)
{
    if (size == 0)
        return 0;

    return arr[size - 1] + sumArray(arr, size - 1);
}

int main()
{
    int arr[] = {1, 3, 6, 7, 9};
    int size = 5;

    cout << "Sum of array elements: " << sumArray(arr, size);

    return 0;
}
