#include <iostream>
#include <string>
#include <algorithm>

using namespace std;


struct Song {
    int songID;
    string songName;
    float duration;
    Song* next;
    Song* prev;

    Song(int id, string name, float dur)
        : songID(id), songName(name), duration(dur), next(nullptr), prev(nullptr) {}
};

class PlaylistManager {
private:
    Song* head;
    Song* current;

public:
    PlaylistManager() : head(nullptr), current(nullptr) {}

 
    void addSong(int id, string name, float duration) {
        Song* newSong = new Song(id, name, duration);
        if (!head) {
            head = newSong;
            current = head;
        }
        else {
            Song* temp = head;
            while (temp->next) {
                temp = temp->next;
            }
            temp->next = newSong;
            newSong->prev = temp;
        }
        cout << "Added: " << name << endl;
    }

    
    void deleteSong(string name) {
        if (!head) return;

        Song* temp = head;
        while (temp) {
            if (temp->songName == name) {
                // If it's the head node
                if (temp == head) {
                    head = head->next;
                    if (head) head->prev = nullptr;
                }
                // If it's not the head
                else {
                    temp->prev->next = temp->next;
                    if (temp->next) {
                        temp->next->prev = temp->prev;
                    }
                }

                // If deleted song was the one currently playing
                if (current == temp) {
                    current = head;
                }

                delete temp;
                cout << "Deleted song: " << name << endl;
                return;
            }
            temp = temp->next;
        }
        cout << "Song not found." << endl;
    }

   
    void playNext() {
        if (current && current->next) {
            current = current->next;
            cout << "Now Playing: " << current->songName << endl;
        }
        else {
            cout << "End of playlist." << endl;
        }
    }

    void playPrevious() {
        if (current && current->prev) {
            current = current->prev;
            cout << "Now Playing: " << current->prev->songName << endl;
        }
        else {
            cout << "At the start of the playlist." << endl;
        }
    }

    
    void shuffleReverse() {
        if (!head) return;

        Song* curr = head;
        Song* temp = nullptr;

        while (curr) {
            
            temp = curr->prev;
            curr->prev = curr->next;
            curr->next = temp;

           
            curr = curr->prev;
        }

        // Adjust head to the last node processed
        if (temp) {
            head = temp->prev;
        }
        cout << "Playlist reversed (Shuffled)." << endl;
    }

    void displayPlaylist() {
        cout << "\n--- Current Playlist ---" << endl;
        Song* temp = head;
        while (temp) {
            string marker = (temp == current) ? "-> " : "   ";
            cout << marker << "ID: " << temp->songID
                << " | Title: " << temp->songName
                << " | " << temp->duration << " mins" << endl;
            temp = temp->next;
        }
        cout << "------------------------\n";
    }
};

int main() {
    PlaylistManager myMusic;

    myMusic.addSong(101, "Blinding Lights", 3.20);
    myMusic.addSong(102, "Bohemian Rhapsody", 5.55);
    myMusic.addSong(103, "Levitating", 3.23);

    myMusic.displayPlaylist();

    myMusic.playNext();
    myMusic.shuffleReverse();
    myMusic.displayPlaylist();

    myMusic.deleteSong("Bohemian Rhapsody");
    myMusic.displayPlaylist();

    return 0;
}
