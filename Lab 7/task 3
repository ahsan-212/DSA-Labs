#include <iostream>
#include <string>

using namespace std;


struct Player {
    int playerID;
    int score;
    Player* next;

    Player(int id) : playerID(id), score(0), next(nullptr) {}
};

class GameManager {
private:
    Player* head;
    Player* currentTurn;
    int playerCount;

public:
    GameManager() : head(nullptr), currentTurn(nullptr), playerCount(0) {}


    void addPlayer(int id) {
        Player* newPlayer = new Player(id);
        if (!head) {
            head = newPlayer;
            head->next = head; 
            currentTurn = head;
        }
        else {
            Player* temp = head;
            while (temp->next != head) {
                temp = temp->next;
            }
            temp->next = newPlayer;
            newPlayer->next = head;
        }
        playerCount++;
        cout << "Player " << id << " joined the game." << endl;
    }

   
    void removePlayer(int id) {
        if (!head) return;

        Player* curr = head, * prev = nullptr;

        
        do {
            if (curr->playerID == id) {
               
                if (curr->next == head && curr == head) {
                    delete curr;
                    head = nullptr;
                    currentTurn = nullptr;
                }
                else {
                   
                    if (currentTurn == curr) {
                        currentTurn = curr->next;
                    }

                    
                    if (curr == head) {
                        
                        Player* last = head;
                        while (last->next != head) last = last->next;
                        head = head->next;
                        last->next = head;
                    }
                    else {
                        prev->next = curr->next;
                    }
                    delete curr;
                }
                playerCount--;
                cout << "Player " << id << " has left the game." << endl;
                checkWinner();
                return;
            }
            prev = curr;
            curr = curr->next;
        } while (curr != head);
    }


    void nextTurn() {
        if (currentTurn) {
            currentTurn = currentTurn->next;
            cout << "It is now Player " << currentTurn->playerID << "'s turn." << endl;
        }
    }

    void skipPlayer() {
        if (currentTurn) {
            cout << "Player " << currentTurn->next->playerID << " was skipped!" << endl;
            currentTurn->next = currentTurn->next->next;
            
            nextTurn();
            nextTurn();
        }
    }

  
    void checkWinner() {
        if (playerCount == 1 && head != nullptr) {
            cout << "\n*** GAME OVER ***" << endl;
            cout << "Winner is Player " << head->playerID << " with " << head->score << " points!" << endl;
        }
    }

    void displayStatus() {
        if (!head) return;
        Player* temp = head;
        cout << "Current Players: ";
        do {
            cout << "[" << temp->playerID << "] -> ";
            temp = temp->next;
        } while (temp != head);
        cout << "(Back to Start)" << endl;
    }
};

int main() {
    GameManager ludo;

    ludo.addPlayer(1);
    ludo.addPlayer(2);
    ludo.addPlayer(3);
    ludo.addPlayer(4);

    ludo.displayStatus();

    ludo.nextTurn(); 
    ludo.nextTurn();

    ludo.removePlayer(2); 
    ludo.displayStatus();

    ludo.nextTurn(); 

    ludo.removePlayer(1);
    ludo.removePlayer(3); 

    return 0;
}
