#include <iostream>
using namespace std;

template <typename T>
class AbstractQueue {
public:
    virtual void enQueue(T value) = 0;
    virtual T deQueue() = 0;
    virtual T front() const = 0;
    virtual bool isEmpty() const = 0;
    virtual bool isFull() const = 0;
    virtual ~AbstractQueue() {}
};

template <typename T>
class myQueue : public AbstractQueue<T> {
private:
    T* arr;
    int maxSize, frontIdx, rearIdx, currentSize;

public:
    myQueue(int size) {
        maxSize = size;
        arr = new T[maxSize];
        frontIdx = 0;
        rearIdx = -1;
        currentSize = 0;
    }
    ~myQueue() { delete[] arr; }

    void enQueue(T value) override {
        if (isFull()) { cout << "Queue Full!\n"; return; }
        rearIdx = (rearIdx + 1) % maxSize;
        arr[rearIdx] = value;
        currentSize++;
    }

    T deQueue() override {
        if (isEmpty()) { cout << "Queue Empty!\n"; return T(); }
        T val = arr[frontIdx];
        frontIdx = (frontIdx + 1) % maxSize;
        currentSize--;
        return val;
    }

    T front() const override { return arr[frontIdx]; }
    bool isEmpty() const override { return currentSize == 0; }
    bool isFull() const override { return currentSize == maxSize; }

    void display() const {
        if (isEmpty()) { cout << "Queue Empty.\n"; return; }
        int temp = frontIdx;
        for (int i = 0; i < currentSize; i++) {
            cout << arr[temp] << " ";
            temp = (temp + 1) % maxSize;
        }
        cout << endl;
    }
};

int main() {
    int size, choice, val;
    cout << "Enter Queue Size: ";
    cin >> size;
    myQueue<int> q(size);

    do {
        cout << "\n1.Enqueue\n2.Dequeue\n3.Front\n4.Display\n5.Exit\nChoice: ";
        cin >> choice;
        switch(choice) {
            case 1: cout << "Value: "; cin >> val; q.enQueue(val); break;
            case 2: cout << "Popped: " << q.deQueue() << endl; break;
            case 3: cout << "Front: " << q.front() << endl; break;
            case 4: q.display(); break;
        }
    } while (choice != 5);
    return 0;
}
