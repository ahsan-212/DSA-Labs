#include <iostream>
using namespace std;

template <typename T>
class myQueue {
private:
    T* arr;
    int maxSize, frontIdx, rearIdx, currentSize;
public:
    myQueue(int size) {
        maxSize = size;
        arr = new T[maxSize];
        frontIdx = 0; rearIdx = -1; currentSize = 0;
    }
    ~myQueue() { delete[] arr; }

    void enqueue(T ticket_id) {
        if (currentSize == maxSize) { cout << "Queue Full!\n"; return; }
        rearIdx = (rearIdx + 1) % maxSize;
        arr[rearIdx] = ticket_id;
        currentSize++;
    }

    T dequeue() {
        if (currentSize == 0) return -1;
        T val = arr[frontIdx];
        frontIdx = (frontIdx + 1) % maxSize;
        currentSize--;
        return val;
    }

    T front() { return (currentSize == 0) ? -1 : arr[frontIdx]; }

    void display() {
        int temp = frontIdx;
        for (int i = 0; i < currentSize; i++) {
            cout << "[" << arr[temp] << "] ";
            temp = (temp + 1) % maxSize;
        }
        cout << endl;
    }
};

int main() {
    myQueue<int> ticketQueue(5); 
    int choice, id;

    do {
        cout << "\n--- Ticket System ---\n1. Add Ticket\n2. Resolve Ticket\n3. Peek Next\n4. Display All\n5. Exit\nChoice: ";
        cin >> choice;
        if (choice == 1) {
            cout << "Enter 4-digit ID: "; cin >> id;
            ticketQueue.enqueue(id); 
        } else if (choice == 2) {
            cout << "Resolved Ticket: " << ticketQueue.dequeue() << endl; 
        } else if (choice == 3) {
            cout << "Next in line: " << ticketQueue.front() << endl;
        } else if (choice == 4) {
            ticketQueue.display(); 
        }
    } while (choice != 5);
    return 0;
}
